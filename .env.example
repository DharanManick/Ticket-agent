# ============================================================================
# Ticket Audit Agent - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Google Gemini AI Configuration
# ----------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini LLM auditing, root cause, and recommendations.
# In Google AI Studio / Cloud Run, this is automatically injected.
GEMINI_API_KEY="your-gemini-api-key"

# Primary LLM model used for multi-step ITIL audits and resolution checks.
GEMINI_MODEL="gemini-3.8-flash"

# Embedding model for vector indexing and semantic retrieval.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# ----------------------------------------------------------------------------
# 2. Server & Network Security Configuration
# ----------------------------------------------------------------------------
# Port the Express backend server listens on (default: 3000).
PORT=3000

# CORS Allowed Origin. In production, restrict to your frontend domain (e.g. "https://audit.corp.com").
# Defaults to "*" in development.
CORS_ORIGIN="*"

# APP_URL: The public-facing base URL where this applet/service is hosted.
# Used for self-referential links, OAuth callbacks, and notification links.
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 3. Email & SMTP Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed recipient email domains to prevent open mail relay abuse.
# Leave blank or set to "*" to allow all domains in development.
ALLOWED_EMAIL_DOMAINS=""

# Set to "true" ONLY for local test SMTP servers with self-signed TLS certificates.
# Default is "false" (strict TLS certificate validation enforced).
SMTP_ALLOW_INSECURE_TLS="false"

# SMTP Relay credentials (can be pre-configured here or dynamically updated in UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----------------------------------------------------------------------------
# 4. ServiceNow ITIL Integration Configuration
# ----------------------------------------------------------------------------
# ServiceNow instance URL (e.g. "https://dev12345.service-now.com")
SERVICENOW_INSTANCE="https://dev423209.service-now.com"

# Basic auth service account credentials for ServiceNow REST API access
SERVICENOW_USERNAME="admin"
SERVICENOW_PASSWORD="your-servicenow-password"

# Set to "true" ONLY for self-signed development instances.
# Default is "false" (strict TLS certificate validation enforced).
SNOW_ALLOW_INSECURE_TLS="false"
