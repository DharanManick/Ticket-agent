# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-exp-03-07

# ServiceNow Configuration
SERVICENOW_INSTANCE=https://dev423209.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_servicenow_password

# API Server Configuration
HOST=0.0.0.0
PORT=8000
ENV=development

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./incidents.db

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=alerts@company.com

# Microsoft Graph / Outlook
MICROSOFT_GRAPH_TOKEN=
OUTLOOK_SENDER_MAILBOX=compliance-bot@company.com

# MS Teams Webhook Configuration
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your_webhook_url
TEAMS_MANAGER_WEBHOOK_URL=

# Compliance Thresholds
LOW_SCORE_THRESHOLD=75.0
IDLE_WARNING_THRESHOLD_HOURS=16

# Logging Configuration
LOG_LEVEL=INFO
